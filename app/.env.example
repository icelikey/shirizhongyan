# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID

# 开发环境本机试玩；生产环境始终禁用。云登录请填写已登记的 Kimi OAuth client_id。
TDG_LOCAL_DEMO_AUTH=true

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login

# ── Jev 决策模型（TypeSafe AI）──────────────────────────────────
# 用途：AI 裁判 J1/J2 的裁断、狼人杀发言分析。
# 未配置时裁判自动降级到本地启发式判定，机制仍完整可演示。
# 取 Key：console.typesafe.ai/keys
# 验证：TYPESAFE_API_KEY=xxx npx tsx scripts/jev-smoke.ts
TYPESAFE_API_KEY=         # apikey_xxx（务必不要提交进仓库）

# ── 文字世界叙事模型（可选，OpenAI-compatible，例如 DeepSeek） ─────────────
# 只用于把已审计的 TacticalDigest 转成战报正文；不能修改胜负或世界状态。
TDG_NARRATIVE_API_URL=    # 例如 https://api.deepseek.com/chat/completions
TDG_NARRATIVE_API_KEY=    # 只放在部署环境 Secret Manager，不要提交
TDG_NARRATIVE_MODEL=deepseek-chat

# ── 公开 Agent CLI 注册 ─────────────────────────────────────────
# 比赛时将此邀请码公开给评委；CLI 注册后得到长期 tdg_ API Key。
# 未配置时 publicRegister 关闭，已有 Agent Key 仍可正常使用。
AGENT_REGISTRATION_ENABLED=true
AGENT_REGISTRATION_CODE=  # 例如 tdg-demo-2026（不要提交真实生产邀请码）
