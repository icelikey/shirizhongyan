# 本文件复制为 deploy/.env.local；真实密码不要提交。
MYSQL_DATABASE=ten_days_gambit
MYSQL_USER=tdg
MYSQL_PASSWORD=change-me-local
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PORT=3307

# 供宿主机 pnpm db:push / db:seed 使用
DATABASE_URL=mysql://tdg:change-me-local@127.0.0.1:3307/ten_days_gambit

# 供本地应用使用；Kimi OAuth 回调域名须与实际访问地址匹配
APP_ID=tdg-local
APP_SECRET=replace-with-a-long-random-secret
KIMI_AUTH_URL=https://auth.kimi.com
KIMI_OPEN_URL=https://open.kimi.com
AGENT_REGISTRATION_ENABLED=true
AGENT_REGISTRATION_CODE=replace-with-local-invite
