# Copy to deploy/.env.prebuilt on ECS and fill in deployment-specific values.
# Images are produced by .github/workflows/container-release.yml on a version tag.
COMPOSE_PROJECT_NAME=ten-days-gambit
APP_IMAGE=ghcr.io/OWNER/REPOSITORY/app:v0.0.0
AGENT_WORKER_IMAGE=ghcr.io/OWNER/REPOSITORY/agent-worker:v0.0.0
APP_ID=tdg-cloud
APP_SECRET=replace-this-before-sharing
DATABASE_URL=mysql://tdg:replace-this-db-password@mysql:3306/ten_days_gambit
MYSQL_DATABASE=ten_days_gambit
MYSQL_USER=tdg
MYSQL_PASSWORD=replace-this-db-password
MYSQL_ROOT_PASSWORD=replace-this-root-password
KIMI_AUTH_URL=https://auth.kimi.com
KIMI_OPEN_URL=https://open.kimi.com
OWNER_UNION_ID=
TYPESAFE_API_KEY=
TDG_NARRATIVE_API_URL=
TDG_NARRATIVE_API_KEY=
TDG_NARRATIVE_MODEL=deepseek-chat
AGENT_REGISTRATION_ENABLED=true
AGENT_REGISTRATION_CODE=replace-this-registration-code
TDG_AGENT_NAME=终焉常驻影从
TDG_INTERVAL_MS=5000
TDG_REPORT_CHANNEL=feishu
TDG_REPORT_WEBHOOK_URL=
TDG_PORT=8080

