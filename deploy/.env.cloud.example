# 复制为 deploy/.env.cloud 后再启动 compose；此文件不放真实密钥。
MYSQL_DATABASE=ten_days_gambit
MYSQL_USER=tdg
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
TDG_PORT=8080
# 启用 docker-compose 的 edge profile 时填写解析到本机的域名；不启用时可留空。
TDG_DOMAIN=
ACME_EMAIL=
HTTP_PORT=80
HTTPS_PORT=443

APP_ID=tdg-cloud
APP_SECRET=change-me-long-random-secret
DATABASE_URL=mysql://tdg:change-me@mysql:3306/ten_days_gambit
KIMI_AUTH_URL=https://auth.kimi.com
KIMI_OPEN_URL=https://open.kimi.com
OWNER_UNION_ID=
TYPESAFE_API_KEY=
TDG_NARRATIVE_API_URL=
TDG_NARRATIVE_API_KEY=
TDG_NARRATIVE_MODEL=deepseek-chat
AGENT_REGISTRATION_ENABLED=true
AGENT_REGISTRATION_CODE=change-me-demo-invite

# 可选：启用 docker-compose 的 agent-worker profile
TDG_AGENT_NAME=终焉常驻影从
TDG_INTERVAL_MS=5000
TDG_REPORT_CHANNEL=feishu
TDG_REPORT_WEBHOOK_URL=
