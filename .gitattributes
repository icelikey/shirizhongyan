# 统一换行符：仓库内一律 LF，检出时由各人本地 core.autocrlf 决定
# 避免三人在 Windows/Mac 混用时产生整文件 diff
* text=auto eol=lf

# 二进制文件，不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp3 binary
*.mp4 binary
release/windows/*.zip filter=lfs diff=lfs merge=lfs -text

# 锁文件与素材不参与 diff 显示（review 时不刷屏）
pnpm-lock.yaml -diff
package-lock.json -diff
*.png -diff
*.svg -diff
